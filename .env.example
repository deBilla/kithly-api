# Copy to .env for `docker compose up`. All values here are placeholders.
PORT=3001
DATABASE_URL=postgres://kithly:kithly@host.docker.internal:5432/kithly?sslmode=disable
REDIS_HOST=redis
REDIS_PORT=6379

AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# base64 of a Firebase service-account JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=
GEMINI_API_KEY=

# Optional
ADMIN_API_KEY=
MAILGUN_API_KEY=
